# Copy to .env and fill in your keys (never commit .env)

# DeepSeek (default provider in modules.yaml)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: Anthropic for verify when using dual-provider setup
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Provider override (defaults to modules.yaml llm.provider)
# LLM_CLIENT=deepseek
# LLM_SCREENING_CLIENT=deepseek
# LLM_VERIFY_CLIENT=deepseek
# LLM_TRANSLATE_CLIENT=deepseek

# Model override (defaults in modules.yaml: pro for scan, flash for translate)
# LLM_SCREENING_MODEL=deepseek-v4-pro
# LLM_VERIFY_MODEL=deepseek-v4-pro
# LLM_TRANSLATE_MODEL=deepseek-v4-flash

# Testing without API calls
# LLM_CLIENT=mock
